# Root .gitignore for the project
# Ignore OS files
.DS_Store
Thumbs.db

# --- Large media / video files ---
# Ignore common video formats and project snapshot/backups folders
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.flv
*.wmv
*.mpeg
*.mpg
snapshots/
backups/

# --- Flutter / Dart ---
# Build and intermediate files generated by Flutter/Dart
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
.packages

# Android (generated)
android/.gradle/
android/app/build/
android/local.properties

# iOS (generated)
ios/Pods/
ios/Runner.xcworkspace/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/.symlinks/

# Generated plugin registrant (if present)
**/generated_plugin_registrant.*

# --- Python ---
# Virtual environments and common build artifacts
venv/
ENV/
env/
.venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/
*.whl

# Environment files (may contain secrets)
.env
.env.*

# --- Node / React / frontend ---
# Node dependencies and build outputs
node_modules/
frontend-react/node_modules/
frontend-react/build/
frontend-react/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.*
.cache/

# --- IDE / Editor ---
.vscode/
.idea/
*.iml

# --- Logs and runtime ---
*.log
.pytest_cache/

# End of .gitignore
)
